<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="pest_title">Pest detection</string>
    <string name="pest_checking">Asking your instance…</string>

    <string name="pest_not_connected_title">Not connected</string>
    <string name="pest_not_connected_body">Connect the app to your kamerplanter instance to identify pests.</string>
    <string name="pest_not_connected_action">Go to Settings</string>

    <string name="pest_not_offered_title">Not available on this instance</string>
    <string name="pest_not_offered_body">Pest detection is switched off, or no recognizer is configured. An administrator enables it on the instance.</string>

    <string name="pest_rejected_title">Connection no longer accepted</string>
    <string name="pest_rejected_body">Your instance refused the stored credential. Connect again to continue.</string>

    <string name="pest_not_permitted_title">Not allowed for your account</string>

    <!-- Consent. The image leaves the instance for an external service, so this is asked
         before the camera opens, never after a photo has been taken.

         The title and body are a FALLBACK only. The instance supplies its own wording for the
         purpose, and that is what the screen shows: this is an Art. 6(1)(a) GDPR consent, and
         nobody should be agreeing to text this app wrote about processing it does not perform.
         These two strings appear only where the instance supplied no wording at all. -->
    <string name="pest_consent_title">Send the photo to an external service?</string>
    <string name="pest_consent_body">Your instance is set up to recognize pests through an external service. Your photo leaves the instance for that. Nothing is uploaded until you agree.</string>
    <string name="pest_consent_action">Agree and continue</string>
    <string name="pest_consent_working">Saving your choice…</string>
    <!-- %1$s is the legal basis the instance records, e.g. "consent". Shown verbatim. -->
    <string name="pest_consent_basis">Legal basis: %1$s</string>

    <!-- Viewfinder -->
    <string name="pest_capture">Identify</string>
    <string name="pest_capturing">Identifying…</string>
    <string name="pest_no_device">Attach a USB microscope to identify a pest.</string>
    <string name="pest_not_understood_title">Unexpected answer</string>
    <string name="pest_not_understood_body">Your instance answered something this version of the app cannot read. Updating the app, or the instance, is what changes that.</string>
    <string name="pest_usb_permission_denied">USB access was declined — this can also happen when the screen locks while the dialog is open.</string>
    <string name="pest_back_to_viewfinder">Back to the viewfinder</string>
    <string name="pest_no_usb_host">This device does not support USB host mode (OTG), so a microscope cannot be attached.</string>
    <string name="pest_awaiting_usb_permission">Waiting for USB permission…</string>
    <string name="pest_connecting">Opening the microscope stream…</string>
    <string name="pest_camera_error">The microscope stream could not be opened.</string>
    <string name="pest_camera_permission">Pest detection needs the camera permission before Android will let the app talk to the microscope.</string>
    <string name="pest_grant_permission">Grant permission</string>
    <string name="pest_open_settings">Open app settings</string>

    <!-- Result -->
    <string name="pest_result_title">What your instance recognized</string>
    <string name="pest_result_again">Take another photo</string>
    <!-- %1$s is a pest or beneficial name, %2$d its confidence as a whole percentage. -->
    <string name="pest_finding">%1$s · %2$d%%</string>
    <string name="pest_mode_direct">Recognized directly</string>
    <string name="pest_mode_symptom">Damage pattern</string>
    <string name="pest_beneficial_badge">Beneficial</string>
    <string name="pest_beneficial_note">This is a beneficial insect. Do not treat it.</string>
    <!-- Screen-reader label for the captured photo with the findings drawn over it. -->
    <string name="pest_photo_description">Your photo with the recognized areas marked</string>
    <!-- %1$d is the number of image tiles the instance ran recognition on. -->
    <string name="pest_tiles">Analysed in %1$d sections</string>

    <string name="pest_abstained_title">No reliable identification</string>
    <string name="pest_abstained_body">Your instance did not recognize anything with enough confidence. Take a closer photo, or inspect the plant yourself.</string>

    <string name="pest_nothing_found_title">Nothing found</string>
    <string name="pest_nothing_found_body">Your instance looked at the photo and recognized no pest and no damage pattern.</string>

    <!-- Failures -->
    <string name="pest_failed_title">That did not work</string>
    <string name="pest_failed_retry">Try again</string>
    <string name="pest_failed_unreachable">Your instance could not be reached. Check that it is running and try again.</string>
    <string name="pest_failed_capture">The microscope did not deliver a frame. Check the cable and try again.</string>
    <string name="pest_failed_phone_capture">The photo could not be taken, or it stayed too large to upload even after being scaled down.</string>

    <!-- Source picker. Both cameras feed the same detection; they suit opposite subjects. -->
    <string name="pest_source_title">What are you photographing?</string>
    <string name="pest_source_phone">Phone camera</string>
    <string name="pest_source_phone_hint">A whole leaf at arm\'s length — best for a damage pattern.</string>
    <string name="pest_source_microscope">USB microscope</string>
    <string name="pest_source_microscope_hint">The animal itself, magnified — best for a pest you can barely see.</string>
    <string name="pest_source_microscope_missing">Attach a USB microscope to use this.</string>
    <string name="pest_source_change">Choose a different camera</string>
    <string name="pest_failed_too_large">The photo is larger than the app will upload. Try again — the microscope retunes for each shot, so the next frame is usually smaller.</string>
    <string name="pest_failed_proxy_limit">The photo was refused before it reached your instance — usually the request-size limit of the web server in front of it. Raising that limit is a change on the server.</string>
    <!-- 422 covers two causes upstream — over the instance's configured size limit, and
         undecodable — and they share one error code, so the message names both. -->
    <string name="pest_failed_not_processable">Your instance would not process the photo. It may be larger than the instance allows, or unreadable.</string>
    <!-- Names the formats, per the feature spec: a rejection the user cannot act on is
         just a dead end. JPEG and PNG are what the backend accepts. -->
    <string name="pest_failed_unsupported_type">Your instance accepts JPEG and PNG photos only, and this one is neither.</string>
    <string name="pest_failed_not_permitted">Your account may not run pest detection in this tenant.</string>
    <string name="pest_failed_consent">Your choice could not be saved. Try again.</string>

    <!-- Human-in-the-loop feedback on a finding (#10). -->
    <string name="pest_feedback_prompt">Was this right?</string>
    <string name="pest_feedback_correct">Correct</string>
    <string name="pest_feedback_wrong">Wrong</string>
    <string name="pest_feedback_beneficial">It is a beneficial</string>
    <string name="pest_feedback_recorded">Thanks — recorded on your instance.</string>
    <string name="pest_feedback_said_correct">You confirmed this finding.</string>
    <string name="pest_feedback_said_wrong">You marked this finding as wrong.</string>
    <string name="pest_feedback_said_beneficial">You marked this as a beneficial.</string>
    <string name="pest_feedback_not_permitted">Your instance does not let this connection record feedback.</string>
    <string name="pest_feedback_failed">The feedback could not be recorded. Try again.</string>

    <!-- Turning a finding into an IPM inspection; needs a permission detection does not. -->
    <string name="pest_inspection_create">Create an inspection</string>
    <string name="pest_inspection_created">Inspection created for this plant.</string>
    <string name="pest_inspection_not_permitted">Your instance does not let this connection create inspections.</string>
    <string name="pest_inspection_failed">The inspection could not be created. Try again.</string>

    <!-- Past detections for the plant this check was opened from. -->
    <string name="pest_history_open">Past checks</string>
    <string name="pest_history_title">Past checks</string>
    <string name="pest_history_close">Close</string>
    <string name="pest_history_empty">No pest check has been recorded for this plant yet.</string>
    <string name="pest_history_loading">Loading past checks…</string>
    <string name="pest_history_failed">The past checks could not be loaded.</string>
    <string name="pest_history_unauthorized">Your instance refused the stored credential.</string>
    <string name="pest_history_not_permitted">Your instance does not let this connection read past checks.</string>
    <string name="pest_history_abstained">No reliable detection</string>
    <!-- %1$d is how many findings that check produced. -->
    <string name="pest_history_findings">%1$d finding(s)</string>

    <!-- The language detection answers should come back in (F-2). Resolved through the
         resource system on purpose: whatever locale folder Android picked for this screen's
         strings is by construction the language the UI speaks, fallbacks included. Each
         locale names its own code here; this is data, not prose. -->
    <string name="pest_result_language">en</string>

    <!-- Keeping the captured frame with the plant (F-3). -->
    <string name="pest_photo_keep">Keep photo with plant</string>
    <string name="pest_photo_kept">The photo was saved to this plant.</string>
    <string name="pest_photo_keep_failed">The photo could not be saved to this plant. The findings are unaffected.</string>
</resources>
