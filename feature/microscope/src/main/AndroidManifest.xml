<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required by the platform, not by any library: AOSP's UsbUserPermissionManager
         refuses to even show the USB permission dialog for a device that exposes a video
         class interface unless the requesting app holds CAMERA. Without it the request is
         answered "denied" within milliseconds and the system logs
         "Camera permission required for USB video class devices". Verified on Android 16. -->
    <uses-permission android:name="android.permission.CAMERA" />

</manifest>
