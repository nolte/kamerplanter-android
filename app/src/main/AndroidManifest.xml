<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- USB host mode is required for the UVC microscope (issue #1), but must not
         exclude devices without OTG from installing: they get a graceful message. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Backup stays on, but the connection's two DataStore files are excluded from it:
         the credential ciphertext is undecryptable without the Keystore key (which is never
         backed up), and the connection record carries the signed-in identity and a private
         instance URL. Both rule files must stay in step — the platform picks by API level. -->
    <application
        android:name=".KamerplanterApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kamerplanter">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
