<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- USB host mode is required for the UVC microscope (issue #1), but must not
         exclude devices without OTG from installing: they get a graceful message. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Reaching an instance on the user's own network. Since Android 16 this is a separate
      runtime grant: INTERNET no longer covers a private address, and without it a connection
      to one is dropped without an error — the app only sees its own connect timeout expire.
      A self-hosted kamerplanter is normally exactly such an address, so this is not an edge
      case for this app but the main path.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Backup stays on, but the connection's two DataStore files are excluded from it:
         the credential ciphertext is undecryptable without the Keystore key (which is never
         backed up), and the connection record carries the signed-in identity and a private
         instance URL. Both rule files must stay in step — the platform picks by API level. -->
    <application
        android:name=".KamerplanterApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kamerplanter">
        <!-- singleTop so a /connect link arriving while the app is already open reaches
             onNewIntent instead of stacking a second copy of the app on top of itself. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The app-recognition contract the backend documents: scanning
                 https://<instance>/connect?v=1 with the system camera opens this app rather
                 than dead-ending in a browser (#13).

                 A wildcard host, and therefore an UNVERIFIED deep link. Auto-verified App
                 Links bind through assetlinks.json to domains named here, and kamerplanter is
                 self-hosted — every instance has its own domain, unknown when this manifest is
                 written. So Android shows a chooser instead, or opens the app directly once
                 the user makes it the default.

                 The link is credential-free by design. The pairing QR carries a one-time code
                 and stays opaque JSON that only the in-app scanner reads: as a publicly
                 openable URL its credential could be routed to whichever app the user picks
                 from that chooser. Only the credential-free link may be recognisable. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- An exact path, not a prefix. A prefix would also claim /connected,
                     /connection and /connect/anything on every host on the internet — links
                     the parser refuses and this app then drops silently, so tapping one in a
                     mail would open kamerplanter on whatever screen it was last on and never
                     reach the page.

                     The two still do not match exactly, and cannot: an intent filter matches
                     no query string, so every https://*/connect is claimed regardless of its
                     `v`, and the parser is what refuses a version this build cannot read. The
                     narrowing is one-sided on purpose — it removes the claims that are never
                     ours, and leaves the ones only the parser can judge.

                     Both web schemes, because a `/connect` link is built from the instance's
                     own `window.location.origin` and a self-hosted instance without TLS emits
                     an `http://` one. Claiming https alone was the narrower stake and it cost
                     more than it saved: a development instance's link opened a browser that
                     could not reach it, and an unusable one — plain http to a routable host —
                     never reached the app at all, so the explanation this channel now carries
                     had nothing to explain (#40).

                     Claiming a link is not trusting it. What may be connected to is
                     `InstanceAddressPolicy`'s decision, unchanged: cleartext is accepted only
                     at a private address, and a cleartext link to a routable host is refused
                     with that reason said out loud. The link itself is credential-free either
                     way, and nothing is connected to without the user agreeing to it on the
                     settings screen. -->
                <data
                    android:scheme="https"
                    android:host="*"
                    android:path="/connect" />
                <data
                    android:scheme="http"
                    android:host="*"
                    android:path="/connect" />
            </intent-filter>
        </activity>
    </application>

</manifest>
