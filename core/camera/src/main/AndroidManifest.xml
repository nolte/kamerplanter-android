<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Declared by the module that owns the permission, so a feature using this camera gets
         it by depending on this module rather than by inheriting it from somewhere unrelated.
         :feature:pestdetection reached CAMERA only through :feature:microscope, a dependency
         the phone path is meant to shed — and the permission would have disappeared from the
         merged manifest with it, failing at runtime rather than at build time. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- The CAMERA permission makes Play imply `android.hardware.camera` and `.autofocus` as
         *required*, which filters the app off every device without a rear camera. Overriding
         needs those exact names — `camera.any` is a different feature and leaves the implied
         requirement in place. A device without a camera can still connect to an instance and
         read its plants, and the microscope path wants the permission for the USB dialogue
         rather than for a camera of its own. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />


    <application>

        <!--
          Hands the system camera a place to write a full-size photo.

          `TakePicturePreview` needs no provider but hands back a thumbnail-sized bitmap, which
          is not a plant photo anybody would want in a diary. Declared here rather than in
          `:app` so the module that launches the capture also carries what the capture needs;
          the authority is derived from the application id at runtime, so an app embedding this
          module needs no manifest of its own.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.camera.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/camera_file_paths" />
        </provider>
    </application>

</manifest>
