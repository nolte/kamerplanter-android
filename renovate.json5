{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // Portfolio-wide baseline, pinned to a gh-plumbing release tag so the
  // shared Renovate behaviour never drifts silently underneath this repo.
  extends: ['github>nolte/gh-plumbing//renovate-configs/common#v2.0.0'],

  // Grouping cut (see the block of packageRules below): groups follow the
  // VERIFICATION METHOD, not the ecosystem. Everything a reviewer checks with
  // the same handgrip travels in one pull request; everything that needs its
  // own check travels alone. Without this the ~36 update streams of this repo
  // (23 version refs, 6 actions, the wrapper, pre-commit, the mkdocs stack)
  // each open their own pull request.
  minimumReleaseAge: '3 days',
  prConcurrentLimit: 5,

  packageRules: [
    {
      // The UVC engine is never bumped mechanically — a bump is a source change plus a
      // hardware retest on a real microscope. Both coordinates are matched: the upstream
      // one we came from, and nolte/AndroidUSBCamera, our fork carrying the 16 KB-aligned
      // native libraries (#14).
      //
      // The fork makes this rule more important, not less. It carries upstream's tags, so
      // JitPack can resolve 3.2.7, 3.3.2 and 3.3.3 from it — and under both Maven and
      // semver ordering the plain 3.2.7 sorts ABOVE the prerelease 3.2.7-16kb.2 we pin.
      // Without this guard Renovate would offer a "newer" version that silently reverts
      // the alignment fix. See spec/android/uvc-microscope/ in claude-android-engineering.
      matchPackageNames: [
        'com.github.jiangdongguo.AndroidUSBCamera:{/,}**',
        'com.github.nolte.AndroidUSBCamera:{/,}**',
      ],
      enabled: false,
    },
    {
      // KSP binds to the Kotlin compiler API. Bumping one without the other breaks the
      // Hilt code generation, so the two only ever move together. The `[.:]` boundary
      // keeps org.jetbrains.kotlinx (a runtime library on its own release train) out.
      //
      // separateMajorMinor is off because it is what would break the lockstep: Renovate
      // prefixes the groupSlug with `major-` for a major update, so a Kotlin major beside
      // a KSP minor would split into two branches — each red on its own, which is exactly
      // what this group exists to prevent.
      groupName: 'kotlin toolchain',
      matchPackageNames: ['/^org\\.jetbrains\\.kotlin[.:]/', '/^com\\.google\\.devtools\\.ksp/'],
      separateMajorMinor: false,
    },
    {
      // AGP and Gradle share a compatibility matrix (AGP 9 needs Gradle 9). Split across
      // two pull requests each one is red on its own; the second rule pulls the wrapper
      // into the same group by name. separateMajorMinor is off on both for the same
      // reason as the kotlin toolchain above: an AGP major beside a wrapper minor must
      // not land in two separate branches.
      groupName: 'android build toolchain',
      matchPackageNames: ['/^com\\.android[.:]/'],
      separateMajorMinor: false,
    },
    {
      groupName: 'android build toolchain',
      matchManagers: ['gradle-wrapper'],
      separateMajorMinor: false,
    },
    {
      // AndroidX minus the camera artifacts: compile plus unit tests is the whole check.
      groupName: 'androidx',
      matchPackageNames: ['/^androidx\\./', '!/^androidx\\.camera/'],
    },
    {
      // Deliberately outside the androidx group: these drive the QR pairing scanner in
      // feature/settings and the phone camera in feature/pestdetection, so a bump earns a
      // retest on real hardware. One grouped pull request means one device test.
      groupName: 'camera & vision',
      matchPackageNames: ['/^androidx\\.camera/', '/^com\\.google\\.mlkit/'],
    },
    {
      // Covered by the MockWebServer tests in core/network.
      groupName: 'network',
      matchPackageNames: ['/^com\\.squareup\\.(retrofit2|okhttp3)/'],
    },
    {
      groupName: 'kotlinx',
      matchPackageNames: ['/^org\\.jetbrains\\.kotlinx/'],
    },
    {
      // Test path only: a green pipeline is the complete verdict, so these carry the
      // `automerge` label that .github/workflows/automerge.yaml acts on. Majors stay out
      // of the label and remain a human decision.
      groupName: 'test dependencies',
      matchPackageNames: ['/^junit[.:]/', '/^io\\.mockk/', '/^app\\.cash\\.turbine/'],
      matchUpdateTypes: ['minor', 'patch'],
      addLabels: ['automerge'],
    },
    {
      // Every action update — tag bump, digest move, pin — in one reviewed pull request.
      // Deliberately WITHOUT the automerge label, for two reasons:
      //
      //  - A digest bump is not an upstream release: it is whatever SHA the tag points at
      //    now, and a tag is mutable even from a trusted publisher (CVE-2025-30066). The
      //    inherited `pinDigests: true` exists so each pin "ages as a reviewable pull
      //    request instead of silently"; automerging would keep the pin immutable while
      //    throwing away the review that catches a moved tag. minimumReleaseAge does not
      //    help — it gates on release age, and a re-pointed tag is no new release at all.
      //  - "the pull request's own CI run verifies it" holds for ci.yml only. The
      //    reusable-workflow references in automerge.yaml and the four release workflows
      //    are executed by no required check, so a renamed input in a future gh-plumbing
      //    release would merge green and surface at the next release dispatch instead.
      //
      // One grouped pull request per cycle is a negligible review burden either way.
      groupName: 'github actions',
      matchManagers: ['github-actions'],
    },
    {
      // Touches no application code, but deliberately NOT automerged: `task lint` drives
      // Gradle directly and pre-commit only ever runs as a local git hook, so a hook bump
      // reaches no check in CI at all. The mkdocs half is covered by the `Docs build` job
      // — the group stays a single reviewed pull request until both halves are.
      groupName: 'dev tooling',
      matchManagers: ['pre-commit', 'pip_requirements'],
    },
    {
      // Never grouped. A generator bump leaves checkApiClientUpToDate deliberately red
      // until someone runs `./gradlew :core:network:generateApiClient` and commits the
      // result — that red check is the intended signal. Inside a group it would block
      // every passenger sharing the branch. See spec/api/openapi-client-integration/.
      matchPackageNames: ['org.openapitools:openapi-generator-cli'],
      groupName: null,
    },
    {
      // Also never grouped: a detekt release ships new rules, so its pull request comes
      // with new violations across the existing sources and wants its own review.
      matchPackageNames: ['/^io\\.gitlab\\.arturbosch\\.detekt/'],
      groupName: null,
    },
  ],

  // `customManagers` carries `mergeable: true` just like `packageRules`, so Renovate
  // concatenates preset-then-repo: the three managers from gh-plumbing/common
  // (hacs/action, hassfest, nolte/vale-style) stay active alongside the one below. Do not
  // copy the vale-style manager in here when adding Vale to this repo — it is inherited,
  // and a second copy would register the same regex twice against .vale.ini.
  customManagers: [
    {
      customType: 'regex',
      description: 'Age the Task binary version pinned in the setup-task step. The github-actions manager updates the action digest but never looks at its `version:` input, so without this manager the pinned Task release drifts silently while CI keeps reporting green.',
      managerFilePatterns: ['/^\\.github/workflows/.+\\.ya?ml$/'],
      matchStrings: [
        'uses:\\s+go-task/setup-task@[0-9a-f]{40}[^\\n]*\\n\\s+with:\\n\\s+version:\\s+(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'go-task/task',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
  ],
}
