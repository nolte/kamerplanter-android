{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // Portfolio-wide baseline, pinned to a gh-plumbing release tag so the
  // shared Renovate behaviour never drifts silently underneath this repo.
  extends: ['github>nolte/gh-plumbing//renovate-configs/common#v2.0.0'],
  packageRules: [
    {
      // AUSBC is published incompletely upstream: the 3.3.x tags never built libuvc,
      // and the 3.3.x line also renamed the package from com.serenegiant.* to
      // com.jiangdg.*. A bump is therefore never mechanical — it is a source change plus
      // a hardware retest. See spec/android/uvc-microscope/ in claude-android-engineering.
      matchPackageNames: ['com.github.jiangdongguo.AndroidUSBCamera:{/,}**'],
      enabled: false,
    },
  ],
}
